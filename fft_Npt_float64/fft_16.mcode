  - $r30 ($f64) $r28 $r30
  + $r29 ($f64) $r29 $r31
  - $r31 ($f64) $r29 $r31
  + $r24 ($f64) $r24 $r27
  - $r25 ($f64) $r25 $r26
  - $r26 ($f64) $r24 $r27
  + $r27 ($f64) $r25 $r26
