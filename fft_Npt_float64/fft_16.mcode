// Radix-4 FFT, N = 16  (generated by generate_mcode.py from fftN_new.mcode)
//   memory: x[n]=(re,im) at words 0..2N-1, twiddles W_N^k (k<N/2) at words 2N..3N-1
//   output: X[k] in bit-reversed order, in place over x
//   stages: radix-4 L=16 -> radix-4 L=4

//@BLOCK l16_pro
// radix-4 stage L=16 (constant twiddles): setup + prologue
l16_pro:
  ||
  $set $r1 0 0                                      //@ 0
  $set $r26 0 256                                   //@ T
  $null
  $null
  $null
  $null
  $null
  $null
;
l16_pro_b1:
  ||
  $ld ($u256) $r20 [$r0 + $r1 ++8]
  $ld ($u256) $r4 [$r1 + 128]
  $set $r2 0 0                                      //@ 0
  $set $r3 0 0                                      //@ L16_IT-2
  $ld ($u128) $r24 [$r26 + 32]                      //@ 32*S16
  $null
  $null
  $null
;
//@END
//@BLOCK l16_fin
// radix-4 stage L=16 (constant twiddles): last iteration
l16_fin:
  ||
  $ld ($u256) $r28 [$r1 + -192]
  $ld ($u256) $r12 [$r1 + -64]
  $ld ($u256) $r16 [$r1 + -224]
  $ld ($u256) $r8 [$r1 + -96]
  + $r20 ($f64) $r20 $r4
  - $r4 ($f64) $r20 $r4
  + $r23 ($f64) $r23 $r7
  - $r7 ($f64) $r23 $r7
;
l16_fin_b1:
  ||
  + $r22 ($f64) $r22 $r6
  - $r6 ($f64) $r22 $r6
  + $r30 ($f64) $r30 $r14
