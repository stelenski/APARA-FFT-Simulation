;
l16_fin_b12:
  ||
  * $r6 ($f64) $r6 $r30
  * $r7 ($f64) $r7 $r31
  * $r31 ($f64) $r6 $r31
  * $r30 ($f64) $r7 $r30
  * $r10 ($f64) $r10 $r18
  * $r11 ($f64) $r11 $r19
