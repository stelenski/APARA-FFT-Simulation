  + $r19 ($f64) $r19 $r11
  - $r11 ($f64) $r19 $r11
;
l16_fin_b2:
  ||
  + $r28 ($f64) $r28 $r12
  - $r12 ($f64) $r28 $r12
  + $r18 ($f64) $r18 $r10
  - $r10 ($f64) $r18 $r10
  + $r22 ($f64) $r22 $r30
  - $r30 ($f64) $r22 $r30
  + $r23 ($f64) $r23 $r31
  - $r31 ($f64) $r23 $r31
;
l16_fin_b3:
  ||
  + $r21 ($f64) $r21 $r5
  - $r5 ($f64) $r21 $r5
  + $r29 ($f64) $r29 $r13
  - $r13 ($f64) $r29 $r13
  + $r20 ($f64) $r20 $r28
  - $r28 ($f64) $r20 $r28
  + $r30 ($f64) $r30 $r31
  - $r31 ($f64) $r31 $r30
;
l16_fin_b4:
  ||
  + $r21 ($f64) $r21 $r29
  - $r29 ($f64) $r21 $r29
  + $r6 ($f64) $r6 $r15
  - $r7 ($f64) $r7 $r14
  - $r14 ($f64) $r6 $r15
  + $r15 ($f64) $r7 $r14
  * $r30 ($f64) $r30 $r24
  * $r31 ($f64) $r31 $r24
;
l16_fin_b5:
  ||
  $ld ($u256) $r28 [$r1 + -160]
  $ld ($u256) $r20 [$r1 + -32]
  + $r16 ($f64) $r16 $r8
  - $r8 ($f64) $r16 $r8
  + $r17 ($f64) $r17 $r9
  - $r9 ($f64) $r17 $r9
  $st ($u256) [$r0 + $r2 ++8] $r20
  $st ($u256) [$r2 + 64] $r28
;
l16_fin_b6:
  ||
