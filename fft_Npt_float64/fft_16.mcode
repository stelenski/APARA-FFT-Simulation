  ||
  - $r14 ($f64) $r14 $r15
  + $r15 ($f64) $r29 $r28
  - $r10 ($f64) $r10 $r11
  + $r11 ($f64) $r19 $r18
  * $r22 ($f64) $r22 $r16
  * $r23 ($f64) $r23 $r17
  * $r17 ($f64) $r22 $r17
  * $r16 ($f64) $r23 $r16
;
l16_fin_b14:
  ||
  - $r6 ($f64) $r6 $r7
  + $r7 ($f64) $r31 $r30
  * $r20 ($f64) $r20 $r24
  * $r21 ($f64) $r21 $r25
  + $r22 ($f64) $r22 $r23
  - $r23 ($f64) $r17 $r16
  $st ($u256) [$r2 + -64] $r12
  $st ($u256) [$r2 + -96] $r8
;
l16_fin_b15:
  ||
  $st ($u256) [$r2 + -128] $r4
  $st ($u256) [$r2 + -32] $r20
  $set $r1 0 0                                      //@ 0
  $null
  $null
  $null
  $null
  $null
;
//@END
//@BLOCK r4_pro
// final radix-4 stage L=4 (trivial twiddles): setup + prologue
r4_pro:
  ||
  $ld ($u256) $r28 [$r0 + $r1 ++8]
  $ld ($u256) $r24 [$r1 + 32]
  $ld ($u256) $r20 [$r1 + 64]
  $ld ($u256) $r16 [$r1 + 96]
  $set $r2 0 0                                      //@ 0
  $set $r3 0 0                                      //@ R4_IT-2
  $null
  $null
;
//@END
//@BLOCK r4_fin
// final radix-4 stage L=4 (trivial twiddles): last iteration
r4_fin:
  ||
  + $r28 ($f64) $r28 $r24
  - $r24 ($f64) $r28 $r24
  + $r29 ($f64) $r29 $r25
  - $r25 ($f64) $r29 $r25
  + $r30 ($f64) $r30 $r26
  - $r26 ($f64) $r30 $r26
  + $r31 ($f64) $r31 $r27
  - $r27 ($f64) $r31 $r27
;
r4_fin_b1:
