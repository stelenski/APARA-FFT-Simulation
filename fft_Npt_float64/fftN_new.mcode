//=============================================================================
//  fftN_new.mcode  --  radix-4 FFT reference / template          (as written: N = 64)
//=============================================================================
//  This file is a complete, runnable N-point radix-4 FFT program for N = 64.
//  It is used to generate new mcode files for other FFTs any value of N
//
//  Template conventions
//    //@BLOCK <name> ... //@END   a block of bundles; the generator selects,
//                                 repeats (one copy per stage) and orders blocks
//    <instr>   //@ <expr>         N-dependent immediate: the last integer of the
//                                 instruction is replaced by <expr> evaluated for N
//    Blocks after the $halt of the N=64 program form a library used by other N.
//
//  Memory (64-bit words, unchanged layout, nothing else is touched)
//    words 0 .. 2N-1   x[n] = (re, im)             -> 2N entries  (inputs)
//    words 2N .. 3N-1  W_N^k = (cos, -sin), k<N/2   -> N entries   (twiddles)
//    Output: X[k] in bit-reversed order, in place over x.
//    The twiddle area is re-used in place for the per-stage twiddle tables.
//
//  Algorithm: in-place decimation-in-frequency radix-4.  A butterfly writes
//    q0 <- Y0, q1 <- Y2*W^2k, q2 <- Y1*W^k, q3 <- Y3*W^3k   (middle outputs swapped),
//  so the result is in plain binary bit-reversed order.  log2(N) odd: the last
//  radix-4 stage (L=8) is fused with the final radix-2 stage.
//    stage 0 (L=N)   : W^k, W^2k from the half table; W^3k = W[3k] (3k<N/2) or
//                      conj(W[N-3k]) (3k>N/2).  As the table entries are consumed,
//                      T1[m] = W_N^{4m} is written over them (m < N/8).
//    neg             : T1[N/8+m] = -T1[m]   -> T1 = W_{N/4}^m, m < 3N/16
//    stage L>=32     : generic radix-4 stage, table T = W_L^m, m < 3L/4
//    cmp             : T[m] = T[4m]  (table for the next stage)
//    L=16 / L=8      : constant twiddles (W16^2 = c(1-j), W16^4 = -j, ...) folded
//    L=4             : trivial butterflies
//
//  Scheduling: every loop is software pipelined (modulo scheduled); one
//  iteration of the butterfly loops processes a PAIR of butterflies (k, k+1)
//  with 256-bit loads/stores, in 11 bundles (82 instructions incl. branch).
//  Post-increment addressing  [rA + rB ++k]  (rB += k * access size) advances
//  pointers for free.
//
//  Registers (byte addresses; 256-bit loads need a register number divisible by 4)
//    all blocks  r0 = 0 (never written)
//    s0_*, gen_* r1 load ptr, r2 store ptr, r3/r24/r25 quarter offsets 16Q/32Q/48Q,
//                r4-r7 x[k],x[k+1]   r8-r11 x[k+Q..]   r12-r15 x[k+2Q..]   r16-r19 x[k+3Q..]
//                r20-r23 twiddle buffer, r26/r27/r28 pointers to W^k, W^2k, W^3k,
//                r29 pair counter, r30 group counter (stage 0: W^3k address of the
//                straddling pair), r31 stage 0: write pointer of the next twiddle table
//    l16/l8/r4/neg/cmp  r1 load ptr, r2 store ptr, r3 loop counter; l16 and l8 also
//                r24/r25 = (c, -c) = W16^2 resp. W8^1 and r26 = twiddle table base;
//                all other registers hold data
//=============================================================================

//-----------------------------------------------------------------------------
//  N = 64 program: stage 0 (L=64) -> L=16 -> L=4
//-----------------------------------------------------------------------------
//@BLOCK s0_pro
// stage 0 (L=N): setup + prologue
s0_pro:
  ||
  $set $r1 0 0                                        //@ 0
  $set $r24 0 512                                     //@ 8*N
  $null
  $null
  $null
  $null
  $null
  $null
;
s0_pro_b1:
  ||
  $ld ($u256) $r4 [$r0 + $r1 ++0]
  $ld ($u256) $r12 [$r24 + $r1 ++0]
  $set $r3 0 256                                      //@ 4*N
  $set $r25 0 768                                     //@ 12*N
  $set $r29 0 4                                       //@ S0_LOOPA-1
  $set $r31 0 1024                                    //@ T
  $set $r30 0 1520                                    //@ S0_COUT
  $null
;
s0_pro_b2:
  ||
  $ld ($u256) $r8 [$r3 + $r1 ++0]
  $ld ($u256) $r16 [$r25 + $r1 ++1]
  + $r5 ($f64) $r5 $r13
  - $r13 ($f64) $r5 $r13
  + $r7 ($f64) $r7 $r15
  - $r15 ($f64) $r7 $r15
  $set $r27 0 1024                                    //@ T
  $set $r28 0 1024                                    //@ T
;
s0_pro_b3:
  ||
  + $r4 ($f64) $r4 $r12
  - $r12 ($f64) $r4 $r12
  + $r6 ($f64) $r6 $r14
  - $r14 ($f64) $r6 $r14
  + $r10 ($f64) $r10 $r18
  - $r18 ($f64) $r10 $r18
  $set $r2 0 0                                        //@ 0
  $set $r26 0 1024                                    //@ T
;
//@END
//@BLOCK s0_A
// stage 0: butterfly pairs with 3k < N/2 (W3 = W[3k]); runs S0_LOOPA times
//   (loop block: executes S0_LOOPA times; removed by the generator when that is 0)
s0_A:
  ||
  + $r8 ($f64) $r8 $r16
  - $r16 ($f64) $r8 $r16
  + $r9 ($f64) $r9 $r17
  - $r17 ($f64) $r9 $r17
  + $r11 ($f64) $r11 $r19
  - $r19 ($f64) $r11 $r19
  $ld ($u128) $r22 [$r0 + $r28 ++6]
  $ld ($u128) $r20 [$r28 + 48]
;
s0_A_b1:
  ||
  + $r12 ($f64) $r12 $r17
  - $r13 ($f64) $r13 $r16
  - $r16 ($f64) $r12 $r17
  + $r17 ($f64) $r13 $r16
  + $r14 ($f64) $r14 $r19
  - $r15 ($f64) $r15 $r18
  - $r18 ($f64) $r14 $r19
  + $r19 ($f64) $r15 $r18
;
s0_A_b2:
  ||
