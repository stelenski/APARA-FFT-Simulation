  * $r17 ($f64) $r17 $r23
  * $r23 ($f64) $r16 $r23
  * $r22 ($f64) $r17 $r22
  * $r18 ($f64) $r18 $r20
  * $r19 ($f64) $r19 $r21
  * $r21 ($f64) $r18 $r21
  * $r20 ($f64) $r19 $r20
;
s0_A_b3:
  ||
  + $r6 ($f64) $r6 $r10
  - $r10 ($f64) $r6 $r10
  $ld ($u256) $r20 [$r0 + $r26 ++1]
  - $r16 ($f64) $r16 $r17
  + $r17 ($f64) $r23 $r22
  - $r18 ($f64) $r18 $r19
  + $r19 ($f64) $r21 $r20
  $null
;
s0_A_b4:
  ||
  * $r12 ($f64) $r12 $r20
  * $r13 ($f64) $r13 $r21
  * $r21 ($f64) $r12 $r21
  * $r20 ($f64) $r13 $r20
  * $r14 ($f64) $r14 $r22
  * $r15 ($f64) $r15 $r23
  * $r23 ($f64) $r14 $r23
  * $r22 ($f64) $r15 $r22
;
s0_A_b5:
  ||
  + $r7 ($f64) $r7 $r11
  - $r11 ($f64) $r7 $r11
  $ld ($u128) $r20 [$r0 + $r27 ++4]
  $ld ($u128) $r22 [$r27 + 32]
  - $r12 ($f64) $r12 $r13
  + $r13 ($f64) $r21 $r20
  - $r14 ($f64) $r14 $r15
  + $r15 ($f64) $r23 $r22
;
s0_A_b6:
  ||
  + $r4 ($f64) $r4 $r8
  - $r8 ($f64) $r4 $r8
  + $r5 ($f64) $r5 $r9
  - $r9 ($f64) $r5 $r9
  * $r10 ($f64) $r10 $r22
  * $r11 ($f64) $r11 $r23
  * $r23 ($f64) $r10 $r23
  * $r22 ($f64) $r11 $r22
;
s0_A_b7:
  ||
  $st ($u128) [$r0 + $r31 ++1] $r20
  * $r8 ($f64) $r8 $r20
  * $r9 ($f64) $r9 $r21
  * $r21 ($f64) $r8 $r21
  * $r20 ($f64) $r9 $r20
  - $r10 ($f64) $r10 $r11
  + $r11 ($f64) $r23 $r22
  $null
;
s0_A_b8:
  ||
  $ld ($u256) $r4 [$r0 + $r1 ++0]
  $ld ($u256) $r12 [$r24 + $r1 ++0]
  - $r8 ($f64) $r8 $r9
  + $r9 ($f64) $r21 $r20
  $st ($u256) [$r0 + $r2 ++0] $r4
  $st ($u256) [$r24 + $r2 ++0] $r12
  $null
