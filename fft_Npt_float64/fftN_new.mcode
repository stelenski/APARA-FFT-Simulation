  + $r5 ($f64) $r5 $r13
  - $r13 ($f64) $r5 $r13
  + $r7 ($f64) $r7 $r15
  - $r15 ($f64) $r7 $r15
  $st ($u256) [$r3 + $r2 ++0] $r8
