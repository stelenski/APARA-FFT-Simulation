  + $r6 ($f64) $r6 $r14
  - $r14 ($f64) $r6 $r14
  + $r10 ($f64) $r10 $r18
  - $r18 ($f64) $r10 $r18
  ? ($i16) $r29 >--1 $goto s0_A
  $null
